/* NL-DB — Three-Panel Layout Theme (Matching Excalidraw Mockup) */

/* ── Base ─────────────────────────────────────────────────── */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    background-color: #e8f4f8;
    color: #1d1d1f;
}

QMainWindow {
    background-color: #e8f4f8;
}

/* ── Info Bar (top toolbar) ───────────────────────────────── */
#infoBar {
    background-color: #2c3e6b;
    border: none;
    border-bottom: 2px solid #1a2744;
}

#infoLabel {
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    background-color: transparent;
}

/* ── Menu Bar ─────────────────────────────────────────────── */
QMenuBar {
    background-color: #d6eef5;
    color: #1d1d1f;
    border-bottom: 1px solid #b0d4e3;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

/* ── Section Titles ───────────────────────────────────────── */
#sectionTitle {
    font-size: 15px;
    font-weight: bold;
    color: #1a1a2e;
    padding: 4px 0;
    background-color: transparent;
}

#dbSubtitle, #schemaSubtitle {
    font-size: 12px;
    color: #5a6986;
    padding: 0 0 4px 0;
    background-color: transparent;
}

#schemaSectionLabel {
    font-size: 13px;
    font-weight: bold;
    color: #1d1d1f;
    padding: 4px 0 2px 0;
    background-color: transparent;
}

/* ── Tree / Table / Text Inputs ──────────────────────────── */
QTreeWidget, QTableWidget, QTextEdit, QLineEdit {
    background-color: #ffffff;
    border: 1px solid #b0d4e3;
    border-radius: 6px;
    padding: 6px;
    color: #1d1d1f;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

#nlInput {
    background-color: #ffffff;
    border: 1px solid #b0d4e3;
    border-radius: 8px;
    padding: 8px;
    font-size: 13px;
}

QTreeWidget::item {
    padding: 4px;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #e0f0f8;
}

QTreeWidget::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #d6eef5;
    border: none;
    border-right: 1px solid #b0d4e3;
    border-bottom: 1px solid #b0d4e3;
    padding: 6px;
    font-weight: bold;
    color: #2c3e6b;
}

/* ── List Widgets ─────────────────────────────────────────── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #b0d4e3;
    border-radius: 6px;
    padding: 4px;
    color: #1d1d1f;
}

QListWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #e0f0f8;
}

#recentFilesList {
    font-size: 12px;
    color: #3a5a7c;
}

#sampleList {
    font-size: 12px;
    color: #3a5a7c;
}

/* ── Buttons — Default ────────────────────────────────────── */
QPushButton {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #0051a8;
}

QPushButton:pressed {
    background-color: #003d82;
}

QPushButton:disabled {
    background-color: #c0d8e8;
    color: #8a9bb0;
}

/* ── Button Variants ──────────────────────────────────────── */

/* Open Database — Blue */
#btnOpenDB {
    background-color: #3a7bd5;
    color: #ffffff;
}
#btnOpenDB:hover {
    background-color: #2a5fb0;
}

/* New Database — Green */
#btnNewDB {
    background-color: #34c759;
    color: #ffffff;
}
#btnNewDB:hover {
    background-color: #28a745;
}

/* Connect PG — Slate */
#btnConnectPG {
    background-color: #5a6986;
    color: #ffffff;
}
#btnConnectPG:hover {
    background-color: #434f63;
}

/* Cancel Exec — Orange / Red */
#btnCancelExec {
    background-color: #ff6b35;
    color: #ffffff;
}
#btnCancelExec:hover {
    background-color: #e05520;
}

/* Run NatLang — Teal */
#btnRunNatLang {
    background-color: #00a896;
    color: #ffffff;
}
#btnRunNatLang:hover {
    background-color: #008a7a;
}

/* Export CSV — Link style */
#btnExportCSV {
    background-color: transparent;
    color: #007aff;
    font-weight: normal;
    text-decoration: underline;
    border: none;
    padding: 2px 6px;
    font-size: 12px;
}
#btnExportCSV:hover {
    color: #0051a8;
    background-color: transparent;
}

/* Query History buttons — Teal rounded */
#historyBtn {
    background-color: #00a896;
    color: #ffffff;
    border-radius: 12px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: normal;
}
#historyBtn:hover {
    background-color: #008a7a;
}

/* ── SQL Box & Explanation Box ────────────────────────────── */
#sqlBox {
    background-color: #f0faf5;
    border: 1px solid #b0d4c3;
    border-radius: 8px;
}

#sqlContent {
    background-color: #e8f5e9;
    border: 1px solid #a5d6a7;
    border-radius: 6px;
    font-family: 'Consolas', 'Courier New', monospace;
    color: #1b5e20;
    padding: 6px;
    font-size: 12px;
}

#explanationBox {
    background-color: #f5faf0;
    border: 1px solid #c5e1a5;
    border-radius: 8px;
}

#explanationContent {
    background-color: transparent;
    border: none;
    color: #333333;
    font-size: 13px;
}

/* ── Column Pills (Schema Inspector) ─────────────────────── */
#columnPill {
    background-color: #c8f7d5;
    border: 1px solid #81d4a0;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-family: 'Consolas', 'Courier New', monospace;
    color: #1a3a2a;
}

/* ── Columns Frame ────────────────────────────────────────── */
#columnsFrame {
    background-color: transparent;
    border: none;
}

#historyFrame {
    background-color: transparent;
    border: none;
}

/* ── Status Bar ───────────────────────────────────────────── */
#mainStatusBar {
    background-color: #b2e6d4;
    border-top: 1px solid #7fcdb5;
    color: #1a3a2a;
    font-size: 12px;
    padding: 2px 8px;
}

#mainStatusBar QLabel {
    color: #1a3a2a;
    background-color: transparent;
    padding: 0 6px;
    font-size: 12px;
}

/* ── Labels (generic) ─────────────────────────────────────── */
QLabel {
    color: #1d1d1f;
    background-color: transparent;
}

/* ── Scroll Bars ──────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #b0d4e3;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7fbbd4;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #b0d4e3;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #7fbbd4;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #b0d4e3;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #7fbbd4;
}

/* ── Scroll Area ──────────────────────────────────────────── */
#schemaScroll {
    background-color: transparent;
    border: none;
}
